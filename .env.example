# Local development only. Replace the password before deploying anywhere.
POSTGRES_USER=moneyflow
POSTGRES_DB=moneyflow
POSTGRES_PASSWORD=moneyflow_dev_password
# Used by native Go commands. Compose constructs its own URL with host "db".
DATABASE_URL=postgres://moneyflow:moneyflow_dev_password@localhost:5432/moneyflow?sslmode=disable
PORT=8080
SESSION_TTL=720h

# Optional VPS configuration. For free testing use docs/FREE_HOSTING.md instead.
# Non-secret settings only. Passwords and provider credentials live in secrets/.
# Run scripts/production/bootstrap.sh, then fill real domain/storage settings.
POSTGRES_USER=moneyflow
POSTGRES_DB=moneyflow
MONEYFLOW_BACKEND_IMAGE=moneyflow-backend:production
SESSION_TTL=168h
FRANKFURTER_URL=https://api.frankfurter.dev/v2
FX_CACHE_TTL=6h
FX_MAX_STALE=168h
DOMAIN=moneyflow.example.com
ACME_EMAIL=you@example.com
PRIVATE_NETWORK_SUBNET=172.30.50.0/24
CADDY_PRIVATE_IP=172.30.50.10
RESTIC_REPOSITORY=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/YOUR_PRIVATE_BUCKET/moneyflow
AWS_DEFAULT_REGION=auto
BACKUP_UTC_TIME=03:00
BACKUP_RUN_ON_START=true
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

FROM postgres:18.6-alpine3.23
RUN apk add --no-cache bash coreutils util-linux age python3 ca-certificates \
    && mkdir -p /opt/moneyflow-backup /work /output
COPY infra/backup/*.sh infra/backup/*.sql infra/backup/*.py /opt/moneyflow-backup/
RUN chmod 0755 /opt/moneyflow-backup/*.sh
ENTRYPOINT ["/opt/moneyflow-backup/free-backup.sh"]

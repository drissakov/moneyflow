{
  "uid": "moneyflow-operations",
  "title": "MoneyFlow operations",
  "tags": ["moneyflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "API reachable", "description": "Internal metrics scrape availability. Monitor public HTTPS separately from outside the VPS.", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "up{job=\"moneyflow-api\"}", "instant": true}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Database ready", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "moneyflow_database_ready{job=\"moneyflow-api\"}", "instant": true}], "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "NOT READY", "color": "red"}, "1": {"text": "READY", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Last encrypted backup", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "moneyflow_backup_last_run_success{job=\"moneyflow-backups\"}", "instant": true}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FAILED / NEVER", "color": "red"}, "1": {"text": "SUCCESS", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Last isolated restore check", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "moneyflow_backup_restore_last_run_success{job=\"moneyflow-backups\"}", "instant": true}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FAILED / NEVER", "color": "red"}, "1": {"text": "VERIFIED", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "timeseries", "title": "API requests per second", "description": "Health/readiness probes excluded. Route templates contain no user IDs.", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(moneyflow_http_requests_total{job=\"moneyflow-api\",route!~\"/(healthz|readyz)\"}[$__rate_interval]))", "legendFormat": "{{route}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "HTTP status rates", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(moneyflow_http_requests_total{job=\"moneyflow-api\",route!~\"/(healthz|readyz)\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Request latency p50 / p95", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(moneyflow_http_request_duration_seconds_bucket{job=\"moneyflow-api\",route!~\"/(healthz|readyz)\"}[$__rate_interval])))", "legendFormat": "p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(moneyflow_http_request_duration_seconds_bucket{job=\"moneyflow-api\",route!~\"/(healthz|readyz)\"}[$__rate_interval])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "5xx errors by route", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(moneyflow_http_requests_total{job=\"moneyflow-api\",status=~\"5..\",route!~\"/(healthz|readyz)\"}[$__rate_interval]))", "legendFormat": "{{route}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "PostgreSQL connection pool", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "moneyflow_database_connections_open{job=\"moneyflow-api\"}", "legendFormat": "open"}, {"refId": "B", "expr": "moneyflow_database_connections_in_use{job=\"moneyflow-api\"}", "legendFormat": "in use"}, {"refId": "C", "expr": "moneyflow_database_connections_idle{job=\"moneyflow-api\"}", "legendFormat": "idle"}, {"refId": "D", "expr": "moneyflow_database_connections_max{job=\"moneyflow-api\"}", "legendFormat": "limit"}], "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Go process memory", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "go_memstats_heap_alloc_bytes{job=\"moneyflow-api\"}", "legendFormat": "heap allocated"}, {"refId": "B", "expr": "go_memstats_sys_bytes{job=\"moneyflow-api\"}", "legendFormat": "Go memory reserved"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Database pool waits", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "rate(moneyflow_database_connection_waits_total{job=\"moneyflow-api\"}[$__rate_interval])", "legendFormat": "waits / second"}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Go goroutines", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "go_goroutines{job=\"moneyflow-api\"}", "legendFormat": "goroutines"}], "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []}},
    {"id": 13, "type": "stat", "title": "Hours since last successful backup / integrity / restore", "description": "Values above 26 hours trigger alerts. No previous success is shown as a large age.", "gridPos": {"x": 0, "y": 36, "w": 18, "h": 5}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "(time() - moneyflow_backup_last_success_timestamp_seconds{job=\"moneyflow-backups\"}) / 3600", "legendFormat": "Backup", "instant": true}, {"refId": "B", "expr": "(time() - moneyflow_backup_check_last_success_timestamp_seconds{job=\"moneyflow-backups\"}) / 3600", "legendFormat": "Integrity", "instant": true}, {"refId": "C", "expr": "(time() - moneyflow_backup_restore_last_success_timestamp_seconds{job=\"moneyflow-backups\"}) / 3600", "legendFormat": "Restore", "instant": true}], "fieldConfig": {"defaults": {"unit": "h", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 26}]}}, "overrides": []}, "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value_and_name"}},
    {"id": 14, "type": "stat", "title": "Last backup duration", "gridPos": {"x": 18, "y": 36, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "moneyflow_backup_duration_seconds{job=\"moneyflow-backups\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 15, "type": "table", "title": "Firing alerts", "gridPos": {"x": 0, "y": 41, "w": 24, "h": 7}, "datasource": {"type": "prometheus", "uid": "moneyflow-prometheus"}, "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "instant": true, "format": "table"}], "options": {"showHeader": true}}
  ]
}
